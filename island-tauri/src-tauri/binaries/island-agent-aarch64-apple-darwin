#!/bin/sh
# Sidecar wrapper for Cue.
#
# WICHTIG: Bewusst tsx/node statt bun-compile – der Orchestrator haengt
# unter der Bun-Runtime beim Solari-WebSocket (gelernt: immer tsx nutzen).
# stdout = JSONL-Events, stderr = menschliche Logs.
cd "${CUE_PROJECT_DIR:-$(pwd)}"
exec npx --yes tsx orchestrator.ts "$@"
