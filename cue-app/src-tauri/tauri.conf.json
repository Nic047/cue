{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cue",
  "version": "0.1.7",
  "identifier": "com.nicolae.tauri-app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node ../scripts/build-agent.mjs && bun run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/island-agent"
    ],
    "resources": {
      "resources/agent-runtime/": "agent-runtime/"
    },
    "macOS": {
      "dmg": {
        "background": "../../scripts/assets/installer-background.png",
        "windowSize": {
          "width": 640,
          "height": 420
        },
        "windowPosition": {
          "x": 200,
          "y": 160
        },
        "appPosition": {
          "x": 160,
          "y": 222
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 222
        }
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "cue",
        "width": 360,
        "height": 80,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzRTRFNDJFRDY3RjcxNkIKUldScmNYL1dMdVRrdzJpM0VSalFOQnVGTVR3RGdHVk1YOFM0djVtYzZJZ1E5VlhMQ0tkOCtldUQK",
      "endpoints": [
        "https://github.com/Nic047/cue/releases/latest/download/latest.json"
      ]
    }
  }
}
